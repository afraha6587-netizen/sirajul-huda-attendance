generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("TEACHER") // ADMIN, TEACHER
  teacher      Teacher?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Teacher {
  id            String         @id @default(uuid())
  userId        String?        @unique
  user          User?          @relation(fields: [userId], references: [id])
  name          String
  code          String         @unique
  active        Boolean        @default(true)
  classSubjects ClassSubject[]
  createdAt     DateTime       @default(now())
}

model AcademicYear {
  id             String               @id @default(uuid())
  name           String               @unique // e.g. "2026-2027"
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean              @default(true)
  weeklyOffDay   String               @default("SUNDAY") // "SUNDAY", "FRIDAY", "SATURDAY"
  classes        Class[]
  academicMonths AcademicMonth[]
  holidays       InstitutionHoliday[]
}

model AcademicMonth {
  id                    String               @id @default(uuid())
  academicYearId        String
  academicYear          AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  monthName             String               // e.g. "July"
  year                  Int                  // e.g. 2026
  workingDays           Int                  @default(23)
  subjectMonthlyConfigs SubjectMonthlyConfig[]
  holidays              InstitutionHoliday[]
}

model InstitutionHoliday {
  id                 String        @id @default(uuid())
  academicYearId     String
  academicYear       AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  monthId            String?
  academicMonth      AcademicMonth? @relation(fields: [monthId], references: [id], onDelete: SetNull)
  title              String        // e.g. "Hostel Monthly Leave", "Eid Al-Fitr", "Independence Day"
  startDate          String        // YYYY-MM-DD
  endDate            String        // YYYY-MM-DD
  type               String        @default("HOLIDAY") // "HOSTEL_LEAVE", "HOLIDAY", "WEEKLY_OFF", "SPECIAL"
  affectsWorkingDays Boolean       @default(true)
  createdAt          DateTime      @default(now())
}

model Class {
  id                 String              @id @default(uuid())
  name               String              // e.g. "D-3", "D-1", "HS-1", "HS-2"
  academicYearId     String
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  active             Boolean             @default(true)
  students           Student[]
  classSubjects      ClassSubject[]
  attendanceSessions AttendanceSession[]
  dailyAttendances   DailyAttendance[]
}

model Student {
  id                String             @id @default(uuid())
  registerNumber    String             @unique
  rollNumber        Int
  name              String
  classId           String
  class             Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  admissionNo       String?
  phone             String?
  parentPhone       String?
  active            Boolean            @default(true)
  dateJoined        DateTime           @default(now())
  attendanceRecords AttendanceRecord[]
  dailyAttendances  DailyAttendance[]
}

model Subject {
  id            String         @id @default(uuid())
  name          String         // e.g. "تفسير الجلالين"
  arabicName    String?
  code          String         @unique
  active        Boolean        @default(true)
  classSubjects ClassSubject[]
}

model ClassSubject {
  id                    String                 @id @default(uuid())
  classId               String
  class                 Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId             String
  subject               Subject                @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId             String
  teacher               Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  active                Boolean                @default(true)
  subjectMonthlyConfigs SubjectMonthlyConfig[]
  attendanceSessions    AttendanceSession[]

  @@unique([classId, subjectId])
}

model SubjectMonthlyConfig {
  id               String        @id @default(uuid())
  classSubjectId   String
  classSubject     ClassSubject  @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  monthId          String
  academicMonth    AcademicMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  availableClasses Int           @default(23)

  @@unique([classSubjectId, monthId])
}

model AttendanceSession {
  id             String             @id @default(uuid())
  classId        String
  class          Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String
  classSubjectId String
  classSubject   ClassSubject       @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  teacherId      String
  date           String             // YYYY-MM-DD
  period         Int                @default(1)
  topicTaught    String?            // Kitab lesson / topic covered in session
  kitabPage      String?            // Kitab page or chapter reference
  status         String             @default("COMPLETED")
  createdById    String
  records        AttendanceRecord[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String            // "PRESENT", "ABSENT", "LEAVE"
}

model DailyAttendance {
  id          String   @id @default(uuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date        String   // YYYY-MM-DD
  status      String   // "PRESENT", "ABSENT", "LEAVE"
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([classId, studentId, date])
}

model SystemSettings {
  id                  String @id @default("1")
  collegeName         String @default("Sirajul Huda College of Science and Integrated Studies, Nadapuram (Affiliated to Jamiathul Hind Al Islamiya)")
  logoUrl             String @default("")
  attendanceThreshold Float  @default(75.0)
  timezone            String @default("Asia/Kolkata")
  dateFormat          String @default("YYYY-MM-DD")
  weeklyOffDay        String @default("SUNDAY")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  timestamp DateTime @default(now())
}
